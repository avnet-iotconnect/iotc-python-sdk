# Copy to iotc.env in the project folder and fill in. The firmware starters and preflight.py load it
# automatically (variables already set in the environment win; relative paths are relative to this file).
# Never commit the filled-in file: add iotc.env and certs/ to .gitignore. On Linux: chmod 600 iotc.env Values come from the /IOTCONNECT platform (see references/sample-config-map.md).

# Device unique id as registered in the platform (device must be Active and Acquired)
IOTC_UNIQUE_ID=''
# Settings -> Key Vault in the platform
IOTC_CPID=''
IOTC_ENV=''
# Alternative to CPID + ENV
IOTC_SID=''
# aws or az
IOTC_PF='aws'
# https://discovery.iotconnect.io for most environments; the EU Azure environment uses its own host
IOTC_DISCOVERY_URL='https://discovery.iotconnect.io'

# X.509 devices: three files. The root CA file name must end in .pem
# Project layout: certs/<UniqueId>/ (or certs/ for one device); run preflight.py to have them found
IOTC_KEY='certs/<UniqueId>/pk_<name>.pem'
IOTC_CERT='certs/<UniqueId>/cert_<name>.crt'
IOTC_CA='certs/<UniqueId>/AmazonRootCA1.pem'
# Symmetric-key devices: use this instead of the three paths above
IOTC_PRIMARY_KEY=''

# Seconds between readings; must not be shorter than the template dataFrequency
IOTC_SEND_INTERVAL='60'
IOTC_DEBUG='0'
# The device template exported from the platform (templates/ or template/)
IOTC_TEMPLATE='templates/<template>.json'
